# =============================================================================
# Configuración automática del entorno para HDF5-Aerospace-Calculations
# =============================================================================

# Activar entorno virtual Python con workon si está disponible
if declare -f workon >/dev/null 2>&1; then
    # Usar virtualenvwrapper (workon está disponible como función)
    workon general 2>/dev/null
    if [ $? -eq 0 ]; then
        echo "🐍 Entorno virtual 'general' activado con workon"
        echo "   Python: $(python --version)"
        echo "   Pip: $(pip --version | cut -d' ' -f1-2)"
    else
        echo "⚠️  workon general falló, usando activación directa..."
        if [ -d "/home/lmoreno/.virtualenvs/general" ]; then
            source /home/lmoreno/.virtualenvs/general/bin/activate
            echo "🐍 Entorno virtual 'general' activado directamente"
            echo "   Python: $(python --version)"
            echo "   Pip: $(pip --version | cut -d' ' -f1-2)"
        fi
    fi
else
    # Fallback: activación directa
    echo "ℹ️  workon no disponible, usando activación directa..."
    if [ -d "/home/lmoreno/.virtualenvs/general" ]; then
        source /home/lmoreno/.virtualenvs/general/bin/activate
        echo "🐍 Entorno virtual 'general' activado directamente"
        echo "   Python: $(python --version)"
        echo "   Pip: $(pip --version | cut -d' ' -f1-2)"
    else
        echo "⚠️  Entorno virtual 'general' no encontrado"
    fi
fi

# Variables de entorno específicas del proyecto
export PROJECT_NAME="HDF5-Aerospace-Calculations"
export HDF5_ROOT="/usr/include/hdf5/serial"
export OMP_NUM_THREADS=8  # Por defecto para OpenMP (futuro)

# Alias útiles para el proyecto
alias build='make all'
alias test-quick='make test-quick'
alias test-full='make test'
alias clean='make clean'
alias analyze='./build/data_analyzer'
alias generate='./build/matrix_generator'
alias visualize='python3 python/visualize_results.py --modal'

echo "🚀 Entorno HDF5-Aerospace listo!"
echo "   Comandos: build, test-quick, test-full, clean, analyze, generate, visualize"