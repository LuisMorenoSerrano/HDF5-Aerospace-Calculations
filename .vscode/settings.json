{
    // ==========================================
    // CONFIGURACIÓN MODERN FORTRAN EXTENSION
    // ==========================================

    // Ruta del ejecutable fortls
    "fortran.fortls.path": "/home/lmoreno/.virtualenvs/general/bin/fortls",

    // Directorios principales para Modern Fortran extension
    "fortran.fortls.directories": [
        "src/**",
        "build/**",
        "/usr/include/hdf5/serial/**"
    ],

    // Compilador para linting (alternativo a fortls)
    "fortran.linter.compiler": "gfortran",
    "fortran.linter.extraArgs": ["-I/usr/include/hdf5/serial"],

    // ==========================================
    // CONFIGURACIÓN DE WORKSPACE
    // ==========================================

    // Asociaciones de archivos
    "files.associations": {
        "*.f90": "FortranFreeForm",
        "*.F90": "FortranFreeForm"
    }

    // NOTA: Configuración detallada de fortls en archivo .fortls
    // según documentación oficial: https://fortls.fortran-lang.org/options.html
}